// Copy this file to secrets.h and fill in your own values.
// secrets.h is gitignored so your credentials never get committed.

#pragma once

#define WIFI_SSID "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// Hostname the station will be reachable at on your LAN via mDNS,
// e.g. http://weather.local
#define MDNS_HOSTNAME "weather"

// Password required to push firmware/filesystem updates over WiFi (OTA).
// Pick your own — this gates who can flash new code onto the device.
#define OTA_PASSWORD "change-me"
