// Copy this file to secrets.h and fill in your own values.
// secrets.h is gitignored so your credentials never get committed.

#pragma once

#define WIFI_SSID "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// Hostname the station will be reachable at on your LAN via mDNS,
// e.g. http://weather.local
#define MDNS_HOSTNAME "weather"

// Password required to push firmware/filesystem updates over WiFi (OTA).
// Pick your own — this gates who can flash new code onto the device.
#define OTA_PASSWORD "change-me"

// Self-hosted InfluxDB 2.x instance for long-term history (the on-device
// RAM buffer only holds the last 24h). Create a bucket and an API token
// with read+write access to it, then fill these in. This token stays on
// the ESP32 only - the browser never sees it, since the ESP32 proxies
// history queries through /api/history/range.
#define INFLUXDB_URL "http://192.168.1.50:8086"
#define INFLUXDB_ORG "your-org"
#define INFLUXDB_BUCKET "weather"
#define INFLUXDB_TOKEN "your-api-token"
